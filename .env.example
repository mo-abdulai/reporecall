GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
OPENAI_API_KEY=

REPO_DATA_DIR=data/repositories
CACHE_DIR=data/cache

# Optional PostgreSQL persistence (supply your own local credentials).
DATABASE_URL=
DATABASE_ECHO=false
# Dedicated disposable database for integration tests only.
TEST_DATABASE_URL=

# HTTP service (Uvicorn --host / --port configure the listener)
API_CORS_ORIGINS=[]
API_DOCS_ENABLED=true
API_CANDIDATE_K=50
API_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
API_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
API_QUERY_MODEL=gpt-4.1-mini
